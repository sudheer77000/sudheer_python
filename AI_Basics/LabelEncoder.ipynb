   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "# Sample data\n",
    "colors = [\"Siva\", \"Manoj\", \"Geetha\"]\n",
    "\n",
    "# Create encoder\n",
    "le = LabelEncoder()\n",
    "\n",
    "# Fit and transform\n",
    "encoded_colors = le.fit_transform(colors)\n",
    "\n",
    "print(\"Original:\", colors)\n",
    "print(\"Encoded:\", encoded_colors)"
   ]
  }
 ],
