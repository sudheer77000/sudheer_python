   "source": [
    "import tiktoken\n",
    "\n",
    "enc = tiktoken.encoding_for_model(\"gpt-4o\")\n",
    "\n",
    "text = \"you are god\"\n",
    "\n",
    "tokens = enc.encode(text)\n",
    "\n",
    "print(tokens)\n",
    "print(\"Token count:\", len(tokens))\n",
    "\n",
    "for token in tokens:\n",
    "    print(token, \"->\", enc.decode([token]))"
   ]
  }
 ],
